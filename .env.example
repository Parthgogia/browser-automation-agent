# ---------------------------------------------------------------------------
# Copy to `.env` and edit. Every value below is a working default for local
# development; the stack boots with no edits at all using the `mock` LLM.
# ---------------------------------------------------------------------------

# --- LLM ------------------------------------------------------------------
# Provider: "mock" | "gemini" | "adaptive" | "groq" | "openrouter" | "ollama"
#   mock   -> deterministic scripted provider, no API key, no network.
#             Use it to exercise the whole graph/UI before you have a key.
#   gemini -> Google Gemini via the google-genai SDK.
#   adaptive -> Ollama first for routine tasks; Gemini first for complex tasks;
#               NVIDIA, Groq, OpenRouter, and local providers automatically
#               receive a request when an earlier provider is rate-limited.
#               Add available API keys below; Ollama must be running locally.
LLM_PROVIDER=mock
GEMINI_API_KEY=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
LLM_MODEL=gemini-flash-latest
LLM_TEMPERATURE=0.2
# Model used for the cheap "did this page change / summarise" calls.
LLM_FAST_MODEL=gemini-flash-lite-latest
EMBEDDING_MODEL=gemini-embedding-001

# Adaptive provider chain (used when LLM_PROVIDER=adaptive; `free` is an alias)
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FAST_MODEL=openai/gpt-oss-20b
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openrouter/free
OPENROUTER_FAST_MODEL=openrouter/free
# NVIDIA Build.NVIDIA.com free endpoints (Muse, GLM, Nemotron)
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MUSE_MODEL=meta/muse-glimmer-30b
NVIDIA_GLM_MODEL=z-ai/glm-5.3-flash
NVIDIA_NEMOTRON_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:9b
OLLAMA_FAST_MODEL=qwen3.5:4b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text:latest
# How long a provider is skipped after a quota/network/server failure.
LLM_FALLBACK_COOLDOWN_S=60

# --- Database (docker compose up -d postgres) ------------------------------
DATABASE_URL=postgresql+asyncpg://agent:agent@localhost:5433/browser_agent

# --- Browser (runs natively on the host, not in Docker) --------------------
# headed = you watch Chromium work. Set to true for headless.
BROWSER_HEADLESS=false
BROWSER_CHANNEL=chromium
BROWSER_VIEWPORT_WIDTH=1440
BROWSER_VIEWPORT_HEIGHT=900
# Persistent Playwright profile root. One subdirectory per profile name,
# so cookies/logins survive between runs.
#
# Leave this unset unless you want the profiles somewhere else: the default is
# `<repo>/data/profiles`, resolved from the source tree rather than from the
# working directory. A *relative* value here is resolved against wherever the
# process was started, so `./data/profiles` silently means a different profile
# depending on whether you launch from the repo root or from `backend/` -- and
# a profile the agent cannot find is a profile whose logins it has lost. If you
# do set it, make it an absolute path.
# BROWSER_PROFILE_DIR=/absolute/path/to/profiles
BROWSER_DEFAULT_PROFILE=default
# Hard ceiling on a single Playwright call, milliseconds.
BROWSER_ACTION_TIMEOUT_MS=15000
# Page a freshly launched browser lands on. Starting on about:blank gives the
# model an empty first observation and shows the human a blank preview pane for
# the whole first step. Set to about:blank to disable.
BROWSER_START_URL=https://duckduckgo.com/

# --- Agent limits ----------------------------------------------------------
# Safety rails. A runaway agent is stopped by whichever trips first.
AGENT_MAX_STEPS=40
AGENT_MAX_FAILURES=8
AGENT_MAX_REFLECTIONS=3
AGENT_STEP_TIMEOUT_S=120

# --- Vision fallback -------------------------------------------------------
# Attach an annotated screenshot when the DOM index looks unhelpful, or
# always, or never. One of: "auto" | "always" | "never"
VISION_MODE=auto

# --- Search ----------------------------------------------------------------
# Optional. Without a key the agent falls back to driving the browser to
# DuckDuckGo's HTML endpoint, which needs no credentials.
TAVILY_API_KEY=

# --- Safety ----------------------------------------------------------------
# Comma-separated. Empty allowlist means "any domain".
ALLOWED_DOMAINS=
BLOCKED_DOMAINS=
# Require human approval before irreversible actions (payments, deletes,
# sending messages). Turning this off is not recommended.
REQUIRE_APPROVAL=true

# --- Server ----------------------------------------------------------------
HOST=127.0.0.1
PORT=8000
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Copy to `.env` and edit. Every value below is a working default for local
# development; the stack boots with no edits at all using the `mock` LLM.
# ---------------------------------------------------------------------------

# --- LLM ------------------------------------------------------------------
# Provider: "gemini" | "mock"
#   mock   -> deterministic scripted provider, no API key, no network.
#             Use it to exercise the whole graph/UI before you have a key.
#   gemini -> Google Gemini via the google-genai SDK.
LLM_PROVIDER=mock
GEMINI_API_KEY=
LLM_MODEL=gemini-flash-latest
LLM_TEMPERATURE=0.2
# Model used for the cheap "did this page change / summarise" calls.
LLM_FAST_MODEL=gemini-flash-lite-latest
EMBEDDING_MODEL=gemini-embedding-001

# --- Database (docker compose up -d postgres) ------------------------------
DATABASE_URL=postgresql+asyncpg://agent:agent@localhost:5433/browser_agent

# --- Browser (runs natively on the host, not in Docker) --------------------
# headed = you watch Chromium work. Set to true for headless.
BROWSER_HEADLESS=false
BROWSER_CHANNEL=chromium
BROWSER_VIEWPORT_WIDTH=1440
BROWSER_VIEWPORT_HEIGHT=900
# Persistent Playwright profile root. One subdirectory per profile name,
# so cookies/logins survive between runs.
BROWSER_PROFILE_DIR=./data/profiles
BROWSER_DEFAULT_PROFILE=default
# Hard ceiling on a single Playwright call, milliseconds.
BROWSER_ACTION_TIMEOUT_MS=15000

# --- Agent limits ----------------------------------------------------------
# Safety rails. A runaway agent is stopped by whichever trips first.
AGENT_MAX_STEPS=40
AGENT_MAX_FAILURES=8
AGENT_MAX_REFLECTIONS=3
AGENT_STEP_TIMEOUT_S=120

# --- Vision fallback -------------------------------------------------------
# Attach an annotated screenshot when the DOM index looks unhelpful, or
# always, or never. One of: "auto" | "always" | "never"
VISION_MODE=auto

# --- Search ----------------------------------------------------------------
# Optional. Without a key the agent falls back to driving the browser to
# DuckDuckGo's HTML endpoint, which needs no credentials.
TAVILY_API_KEY=

# --- Safety ----------------------------------------------------------------
# Comma-separated. Empty allowlist means "any domain".
ALLOWED_DOMAINS=
BLOCKED_DOMAINS=
# Require human approval before irreversible actions (payments, deletes,
# sending messages). Turning this off is not recommended.
REQUIRE_APPROVAL=true

# --- Server ----------------------------------------------------------------
HOST=127.0.0.1
PORT=8000
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO
